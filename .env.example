NEXT_PUBLIC_SUPABASE_URL=your-project-url-here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Hubtel SMS credentials (server-side only; configure in Vercel)
HUBTEL_SMS_CLIENT_ID=your-hubtel-client-id
HUBTEL_SMS_CLIENT_SECRET=your-hubtel-client-secret
HUBTEL_SMS_SENDER_ID=BTI
# Optional override if Hubtel assigns a different endpoint to the account
HUBTEL_SMS_API_URL=https://smsc.hubtel.com/v1/messages/send
